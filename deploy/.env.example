# Domain of the server. Required. A/AAAA records for this domain AND for
# rtc.<domain> and turn.<domain> (calls) must point to this server.
FG_DOMAIN=family.example.com

# Admin's phone number (international format). Required.
# This number can always sign in and becomes admin on first login.
FG_ADMIN_PHONE=+79990000000

# Email for Let's Encrypt notices (optional).
FG_ACME_EMAIL=

# Name shown on the login screen.
FG_SERVER_NAME=Familygram

# Max upload size per file, MB.
FG_MAX_UPLOAD_MB=200

# SMS provider for login codes: log | smsru | smsc | twilio
#   log    - codes are only written to the server log:
#            docker compose logs familygram
#   smsru  - sms.ru (good delivery to Russian numbers)
#   smsc   - smsc.ru (good delivery to Russian numbers)
#   twilio - twilio.com
FG_SMS_PROVIDER=log

# sms.ru
FG_SMSRU_API_ID=

# smsc.ru
FG_SMSC_LOGIN=
FG_SMSC_PASSWORD=

# Twilio
FG_TWILIO_SID=
FG_TWILIO_TOKEN=
FG_TWILIO_FROM=

# Calls (LiveKit). install.sh generates these automatically.
# Key: any short id; secret: at least 32 random characters.
#   openssl rand -hex 6    -> key (prefix with API)
#   openssl rand -hex 32   -> secret
FG_LIVEKIT_API_KEY=
FG_LIVEKIT_API_SECRET=

# iPhone push notifications (optional; without them messages arrive only
# while the app is open). In developer.apple.com → Certificates, Identifiers
# & Profiles → Keys, create a key with "Apple Push Notifications service
# (APNs)", download the .p8 file once and put it into deploy/secrets/.
#   FG_APNS_KEY_FILE - path inside the container: /secrets/AuthKey_XXXXXXXXXX.p8
#   FG_APNS_KEY_ID   - the key's Key ID (10 characters)
#   FG_APNS_TEAM_ID  - your Team ID (Membership details)
#   FG_APNS_TOPIC    - the app's bundle ID
FG_APNS_KEY_FILE=
FG_APNS_KEY_ID=
FG_APNS_TEAM_ID=
FG_APNS_TOPIC=org.familygram.familygram

# Use a prebuilt image instead of building locally (optional).
# FG_IMAGE=ghcr.io/<owner>/familygram:latest
